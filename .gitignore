# Raw data (large files, downloaded from the official sources)
data/raw/*
!data/raw/README.md

# Intermediate files
data/processed/*
!data/processed/.gitkeep

# Python / Jupyter
__pycache__/
.ipynb_checkpoints/
.venv/
venv/

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Generated outputs: only the simplified map files are published (the full-detail ones are too large)
outputs/**
!outputs/**/
!outputs/.gitkeep
!outputs/geojson/**/*_simplified.geojson
!outputs/topojson/**/*_simplified.json
